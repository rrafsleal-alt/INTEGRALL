--- /dev/null
+++ b/tests/v11.1.1-audit.test.js
@@ -0,0 +1,122 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile, readdir} from 'node:fs/promises';
+import path from 'node:path';
+
+const root = process.cwd();
+const credential = ['159213', 'Rafs'].join('');
+const text = relative => readFile(path.join(root, relative), 'utf8');
+
+async function filesUnder(relative) {
+  const dir = path.join(root, relative);
+  const out = [];
+  async function walk(current) {
+    for (const entry of await readdir(current, {withFileTypes: true})) {
+      if (['node_modules', '.git'].includes(entry.name)) continue;
+      const full = path.join(current, entry.name);
+      if (entry.isDirectory()) await walk(full);
+      else if (entry.isFile()) out.push(full);
+    }
+  }
+  await walk(dir);
+  return out;
+}
+
+test('versão auditada 11.1.1 está coerente no pacote e na API', async () => {
+  const pkg = JSON.parse(await text('package.json'));
+  const server = await text('server.js');
+  const html = await text('public/index.html');
+  assert.equal(pkg.version, '11.1.1');
+  assert.match(server, /const appVersion = String\(packageMetadata\.version/);
+  assert.match(server, /version:\s*appVersion/);
+  assert.match(html, /integrall-build" content="public-v11\.1\.1-/);
+});
+
+test('detalhes do produto são um único bloco inline depois da listagem', async () => {
+  const html = await text('public/index.html');
+  assert.equal((html.match(/id="productDetails"/g) || []).length, 1);
+  assert.equal((html.match(/id="productModal"/g) || []).length, 0);
+  assert.doesNotMatch(html, /id="productDetails"[^>]*aria-modal=/i);
+  const grid = html.indexOf('id="productGrid"');
+  const details = html.indexOf('id="productDetails"');
+  const footer = html.indexOf('<footer');
+  assert.ok(grid >= 0 && details > grid && footer > details, 'ordem DOM deve ser grade -> detalhes -> rodapé');
+});
+
+test('CSS mantém detalhe no fluxo, em coluna e sem largura mínima global', async () => {
