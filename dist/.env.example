# Servidor
NODE_ENV=development
PORT=3000
# Diretório privado de desenvolvimento. Produção usa PostgreSQL.
LOCAL_DATA_DIR=
PUBLIC_URL=
TRUST_PROXY=false

# PostgreSQL (obrigatório em produção)
DATABASE_URL=
# disable (dev), require (TLS sem validação do certificado) ou verify-full (recomendado em produção)
DATABASE_SSL_MODE=disable
# CA do PostgreSQL em Base64 quando verify-full exigir CA privada
DATABASE_CA_BASE64=

# ===== Administração segura =====
# Desenvolvimento local: com a opção abaixo em true, somente a credencial
# inicial do briefing é aceita; hashes antigos do ambiente ficam inativos.
# Produção: gere um hash com `npm run admin:hash`, preencha ADMIN_PASSWORD_HASH
# e mantenha ADMIN_DEFAULT_LOGIN_ENABLED=false. Nesse modo personalizado,
# somente o hash configurado é aceito; não existe fallback concorrente.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_DEFAULT_LOGIN_ENABLED=true
# admin | editor | operator
ADMIN_ROLE=admin
# Segredo aleatório com pelo menos 32 caracteres (use um gerenciador de segredos em produção)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8

# Atendimento
WHATSAPP_NUMBER=55DDDNUMERO

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_USE_SANDBOX=true
MERCADO_PAGO_PAYMENT_EXPIRATION_DAYS=3

# Frete: correios (automático) | quote (a confirmar) | fixed | zones
SHIPPING_MODE=correios
SHIPPING_FIXED_CENTS=1500
# Vazio respeita as promoções já cadastradas; 0 desativa o limite geral.
FREE_SHIPPING_CENTS=
ALLOW_PAYMENT_WITH_QUOTED_SHIPPING=false

# ===== Correios (API de contrato / CWS) =====
# Usuário do Meu Correios (Pessoa Jurídica)
CORREIOS_USER=
# Código de acesso a APIs gerado no CWS (https://cws.correios.com.br > Gestão de acesso a APIs)
CORREIOS_ACCESS_CODE=
# Número do cartão de postagem do contrato
CORREIOS_POSTAGE_CARD=
# Número do contrato (obrigatório em CORREIOS_AUTH_TYPE=contrato)
CORREIOS_CONTRACT=
# auto = contrato quando informado, senão cartão; contrato | cartaopostagem
CORREIOS_AUTH_TYPE=contrato
# Superintendência Estadual (DR), somente se exigida pelo contrato
CORREIOS_DR=
# CEP usado no teste enviado. Confirme o local REAL de postagem.
CORREIOS_ORIGIN_CEP=07074000
# Serviços a cotar: codigo:rotulo separados por vírgula (padrão: PAC e SEDEX de contrato)
CORREIOS_SERVICES=03298:PAC,03220:SEDEX
# Usa ambiente de homologação dos Correios (apihom) para testes
CORREIOS_HOMOLOG=false
# Cotação igual ao teste manual: GET v1; NÃO copiar o número v3 do catálogo.
CORREIOS_QUOTE_METHOD=GET
# Solicitação OPCIONAL de valor declarado adicional. Revise cobertura e contrato.
CORREIOS_DECLARED_VALUE=false
# HMAC dos recibos da loja; vazio herda ADMIN_SESSION_SECRET. Nunca é o token CWS.
SHIPPING_QUOTE_SECRET=
# Cadastre embalagens reais em Produtos > Embalagens de envio.
# Guia completo: CONFIGURAR-CORREIOS.md

# ===== E-mail transacional (SMTP) =====
# Compatível com Gmail (senha de app), Brevo, SES, Mailgun etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=INTEGRALL
# E-mail que recebe as respostas dos clientes (ex.: atendimento)
SMTP_REPLY_TO=
# true somente para TLS implícito (porta 465)
SMTP_SECURE=false

# ===== Operação =====
# Cancela automaticamente pedidos sem pagamento após N dias (0 desativa)
ORDER_EXPIRE_DAYS=7
# Reserva unidades enquanto o cliente conclui o pagamento
INVENTORY_RESERVATION_MINUTES=15
# Conta do cliente por código enviado por e-mail
CUSTOMER_LOGIN_CODE_MINUTES=10
CUSTOMER_SESSION_DAYS=30
# Segredo HMAC exclusivo e persistente (mínimo 32 caracteres).
# A rotação invalida somente códigos de login pendentes, não sessões já emitidas.
CUSTOMER_AUTH_SECRET=

# ===== Jadlog (API Embarcador — opcional, soma-se aos Correios) =====
# Token fornecido pela franquia Jadlog que atende seu CNPJ
JADLOG_TOKEN=
# CNPJ do tomador do serviço (somente números)
JADLOG_CNPJ=
# Conta corrente Jadlog (se correntista) e contrato (se fornecido)
JADLOG_CONTA=
JADLOG_CONTRATO=
# Modalidade negociada: 3=.Package (padrão e-commerce), 9=.Com, 4=Rodoviário
JADLOG_MODALIDADE=3
# D=entrega em domicílio (padrão), R=retira na unidade
JADLOG_TP_ENTREGA=D
# N=seguro normal Jadlog; A=apólice própria (se sua empresa tiver)
JADLOG_TP_SEGURO=N

# ===== Regra de divisão entre transportadoras =====
# Pedidos com até N unidades vão pelos Correios; acima de N, pela Jadlog.
# Reserva vale para a prévia; no fechamento nunca troca a escolha silenciosamente.
# 0 = desativado (todas as transportadoras cotam sempre)
CARRIER_SPLIT_UNITS=12

# ===== Avançado (testes/homologação) =====
# Deixe vazio. Somente os hosts oficiais HTTPS são aceitos.
CORREIOS_BASE_URL=
# Versão do ENDPOINT de Preço/Prazo, não do nome do catálogo Swagger.
CORREIOS_API_VERSION=v1
JADLOG_BASE_URL=
