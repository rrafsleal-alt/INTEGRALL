# Servidor
NODE_ENV=development
PORT=3000
PUBLIC_URL=
TRUST_PROXY=false

# PostgreSQL (obrigatório em produção)
DATABASE_URL=

# Admin: use um token longo/aleatório. Nunca coloque no HTML.
